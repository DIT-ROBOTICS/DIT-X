# /home/share/eurobot/config/logging.env — read by the eurobot-log-* units (install.sh copies
# this file there once; edit it on the robot).

# Where every container writes (docker/compose.yaml mounts it at /var/log/eurobot inside)
LOG_ROOT=/home/share/eurobot/logs

# Retention (eurobot-log-retention.timer, hourly): files older than RETENTION_DAYS
# are deleted, then the oldest until the folder is below MAX_GB. Logs younger
# than KEEP_RECENT_MIN minutes are never deleted (they are still being written).
RETENTION_DAYS=7
MAX_GB=100
KEEP_RECENT_MIN=60

# Off-robot copy (eurobot-log-sync.timer, nightly; or: systemctl start eurobot-log-sync)
# rsync destination; <hostname>/ is appended. Empty = disabled (e.g. at a competition).
# The deploy user needs passwordless ssh to the NAS host.
NAS_TARGET=
# NAS_TARGET=dit-nas:/volume1/eurobot-logs
